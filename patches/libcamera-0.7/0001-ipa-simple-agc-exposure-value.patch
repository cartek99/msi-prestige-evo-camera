+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
 	void process(IPAContext &context, const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
@@ -26,6 +31,14 @@
 
 private:
 	void updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV);
+
+	/*
+	 * Exposure Value (EV) bias, in log2 stops, applied on top of the
+	 * automatic exposure target. 0.0 leaves the default behaviour
+	 * unchanged; negative values darken the image (useful to protect
+	 * highlights from clipping).
+	 */
+	float exposureValue_ = 0.0f;
 };
 
 } /* namespace ipa::soft::algorithms */
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -65,12 +65,59 @@
 {
 }
 
+int Agc::init(IPAContext &context, const ValueNode &tuningData)
+{
+	/*
+	 * Advertise support for the ExposureValue control so applications can
+	 * bias the automatic exposure target. The range is expressed in log2
+	 * stops; 0.0 is the default (unbiased) behaviour.
+	 */
+	context.ctrlMap[&controls::ExposureValue] = ControlInfo(-8.0f, 8.0f, 0.0f);
+
+	/*
+	 * A per-sensor default bias can be provided in the tuning file. This
+	 * lets a sensor whose soft-ISP tends to over-expose (clipping the
+	 * highlights) ship a sensible negative default that applies to every
+	 * consumer, even those that never set the ExposureValue control. A
+	 * runtime ExposureValue control still overrides it.
+	 */
+	exposureValue_ = tuningData["exposureValue"].get<float>(0.0f);
+	if (exposureValue_ != 0.0f)
+		LOG(IPASoftExposure, Info)
+			<< "Default exposure value from tuning file: "
+			<< exposureValue_;
+
+	return 0;
+}
+
+void Agc::queueRequest([[maybe_unused]] typename Module::Context &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] typename Module::FrameContext &frameContext,
+		       const ControlList &controls)
+{
+	const auto &exposureValue = controls.get(controls::ExposureValue);
+	if (exposureValue.has_value()) {
+		exposureValue_ = exposureValue.value();
+		LOG(IPASoftExposure, Debug)
+			<< "Setting exposure value to " << exposureValue_;
+	}
+}
+
 void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, double exposureMSV)
 {
 	int32_t &exposure = frameContext.sensor.exposure;
 	double &again = frameContext.sensor.gain;
 
-	double error = kExposureOptimal - exposureMSV;
+	/*
+	 * Bias the optimal MSV target by the requested Exposure Value. Each EV
+	 * stop scales the target brightness by a factor of two (log2). The
+	 * result is clamped to the valid MSV range [1, kExposureBinsCount].
+	 */
+	const float exposureOptimal = std::clamp<float>(
+		kExposureOptimal * std::exp2(exposureValue_),
+		1.0f, static_cast<float>(kExposureBinsCount));
+
+	double error = exposureOptimal - exposureMSV;
 
 	if (std::abs(error) <= kExposureSatisfactory)
 		return;
@@ -134,6 +181,7 @@
